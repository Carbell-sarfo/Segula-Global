---

<MainLayout
  title="About | Segula Global Ltd"
  description="Segula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence."
>
  <Navigation />

  <!-- Section hero -->
  <section class="section-hero">
    <div class="container wrapper">
        <div class="w-full h-full hero-content text-center flex align-center flex-col justify-center flex-wrap">
            <h1 class="text-8xl md:text-8xl font-extrabold text-white">Hello!</h1>
            <p class="my-8 text-white">Dear <span class="font-bold italic yellow-text">rule-breakers</span>, <span class="font-bold italic yellow-text">outside-the-box thinkers</span>, kids who disappointed their African parents by not doing law or science at University: we want you!</p>
        </div>
    </div>
   </section>
  <!-- Section Hero -->

  <!-- section Values -->
  <section class="section-values">
    <div class="container wrapper">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
        <div>
          <Image src={ValuesImg} alt="Segula Global's values" />
        </div>
        <div>
          <h1
        class="text-3xl md:text-4xl font-extrabold mb-4 max-w-5xl mx-auto"
      >
        Our Values
      </h1>
          <p class="mb-8">Lorem ipsum dolor sit amet consectetur adipisicing elit. Sapiente fuga consequatur minus, placeat expedita ipsam.</p>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quasi beatae accusamus debitis delectus recusandae minus eligendi fugit amet praesentium soluta.</p>
        </div>
      </div>
    </div>
  </section>



    <!-- section Mission -->
    <section class="section-mission py-32 border-b border-gray-400">
      <div class="container wrapper">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
          <div>
            <Image src={ValuesImg} alt="Segula Global's values" />
          </div>
          <div>
            <h1
        class="text-3xl md:text-4xl font-extrabold mb-4 max-w-5xl mx-auto"
      >
        Our Mission
      </h1>
            <p class="mb-8">Lorem ipsum dolor sit amet consectetur adipisicing elit. Sapiente fuga consequatur minus, placeat expedita ipsam.</p>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quasi beatae accusamus debitis delectus recusandae minus eligendi fugit amet praesentium soluta.</p>
          </div>
        </div>
      </div>
    </section>




  <!-- Section Team members -->
  <div class="section-team" id="team">
    <div class="container wrapper">
      <h1
        class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto"
      >
        Our Team
      </h1>
      <p class="max-w-5xl mx-auto text-center">
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Officia ullam,
        illum illo dolorum a alias.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
          {
            teams.map((team) => (
              <div class="member">
                <div class="member-head">
                  <Image src={team.image} alt={team.name}/>
                  <h3>{team.name}</h3>
                  <p>{team.title}</p>
                </div>
                <div class="member-details">
                  <p class="px-4">{team.details}</p>
                </div>
                <ul class="social-list">
                  <li class="social-item">
                    <a href={team.linkedin} class="social-link">
                      <i class="fa-brands fa-linkedin-in" />
                    </a>
                  </li>
                  <li class="social-item">
                    <a href={team.website} class="social-link">
                      <i class="fa-solid fa-earth-africa" />
                    </a>
                  </li>
                  <li class="social-item">
                    <a href={team.instagram} class="social-link">
                      <i class="fa-brands fa-instagram" />
                    </a>
                  </li>
                </ul>
              </div>
            ))
          }
      </div>
    </div>
  </div>





  <!-- join out team -->
  <section class="section-join">
    <div class="container wrapper">
      <div class="text-center max-w-5xl mx-auto">
        <h1
        class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto"
      >
        Join Our Team
      </h1>
            <p class="mb-8">Lorem ipsum dolor sit amet consectetur adipisicing elit. Sapiente fuga consequatur minus, placeat expedita ipsam.</p>
            <a href="/careers" class="btn btn-yellow">Our Openings</a>
      </div>
    </div>
  </section>
  <Footer />
</MainLayout>

<style lang="scss">

  // Section Hero
  .section-hero {
        width: 100%;
        height: 100vh;
        background-image: linear-gradient(to bottom, var(--clr-green-dark), var(--clr-green));

        .hero-content {
            max-width: 1000px;
            margin-inline: auto;
        }
    }


    // Section values
    .section-values {
      background-color: var(--clr-green);
      padding: 8rem 0 10rem;
      color: var(--clr-white);
    }



    // section join
    .section-join {
      background-color: var(--clr-green-light);
      padding: 5rem 0;
    }





    
  .section-team {
    padding: 7rem 0;
  }
  .member {
    background-color: #f8f8f8;
    padding: 2rem 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.2);
    text-align: center;
    border: 1px solid #b3b3b3;
    transition: 0.3s;

    &:hover {
      transform: translateY(-4px);
    }

    &-head {
      margin-bottom: 2rem;

      img {
        // width: 100%;
        display: inline-block;
        margin-bottom: 1rem;
        max-width: 250px;
      }

      h3 {
        font-weight: bold;
        font-size: 1.5rem;
      }
      p {
        color: var(--clr-green);
        font-size: 1rem;
      }
    }

    .social-list {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 1rem;

      .social-item {
        &:not(:last-child) {
          margin-right: 1rem;
        }
      }

      .social-link {
        display: flex;
        width: 3rem;
        height: 3rem;
        align-items: center;
        justify-content: center;
        background-color: #d8d8d8;
        border: 2px solid #cdcdcd;
        border-radius: 50%;
        color: var(--clr-white);
        transition: 0.4s ease-out;

        &:hover,
        &:focus {
          color: var(--clr-white);
          background-color: var(--clr-green);
        }
      }
    }
  }
</style>
