---
import Navigation from "~/components/navigation.astro";
import Footer from "~/components/footer.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import { Image } from "astro:assets";

import Carbell from "../assets/carbell-sarfo.png";
import Winnard from "../assets/winnard-bansah.png";
import Joshua from "../assets/joshua-awuro.png";
import Richmond from "../assets/richmond-duah.png";
import Sheila from "../assets/sheila-wristberg.png";

// Our Clients
import Irisk from "../assets/partner-irisk.png";
import Nsia from "../assets/partner-nsia.png";
import Ibag from "../assets/partner-ibag.png";
import Wliafrica from "../assets/partner-wliafrica.png";
import NGI from "../assets/partner-ngi.png";
import Coronation from "../assets/partner-coronation.png";
import Swristberg from "../assets/partner-sheila.png";
import Aceltrim from "../assets/partner-aceltrim.png";
import APL from "../assets/partner-apl.png";

import ValuesImg from "../assets/about-studio.png"
// import { array } from "astro:schema";
// import type { Member } from "~/types";

const teams: Array<Member> = [
  {
    name: "Carbell Sarfo",
    title: "Managing Director",
    image: Carbell,
    details:
      "egula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence",
    linkedin: "https://www.linkedin.com/in/carbellsarfo/",
    website: "https://carbellsarfo.netlify.app/",
    instagram: "https://www.instagram.com/carbellsarfo/",
  },
  {
    name: "Sheila Wristberg",
    title: "Lead Generation",
    image: Sheila,
    details:
      "egula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence",
    linkedin: "https://www.linkedin.com/in/sheila-wristberg-b10a3515/",
    website: "https://sheilawristberg.com/",
    instagram: "https://www.instagram.com/sheilawristberg/",
  },
  {
    name: "Richmond Duah",
    title: "Lead Generation",
    image: Richmond,
    details:
      "egula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence",
    linkedin: "https://www.linkedin.com/in/richmondduah/",
    website: "https://richmondduah.netlify.app/",
    instagram: "https://www.instagram.com/rich.mondduah/",
  },
  {
    name: "Winnard Bansah",
    title: "Lead Generation",
    image: Winnard,
    details:
      "egula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence",
    linkedin: "https://www.linkedin.com/in/winnardbansah/",
    website: "https://winnardbansah.netlify.app/",
    instagram: "https://www.instagram.com/winnardbansah/",
  },
  {
    name: "Joshua Awuro-Sampuo",
    title: "Lead Generation",
    image: Joshua,
    details:
      "egula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence",
    linkedin: "https://www.linkedin.com/feed/",
    website: "https://github.com/joshuawuro",
    instagram: "https://www.instagram.com/_joshuawuro",
  },
];
---

<MainLayout
  title="About | Segula Global Ltd"
  description="Segula's mission is to empower professionals and thought leaders by creating authentic, impactful digital identities that drive connection, inspire trust, and amplify influence."
>
  <Navigation />

  <!-- Section hero -->
  <section class="section-hero">
    <div class="container wrapper">
        <div class="w-full h-full hero-content text-center flex align-center flex-col justify-center flex-wrap">
            <h1 class="text-8xl md:text-8xl font-extrabold text-white">The Digital World and Beyond!</h1>
            <p class="my-8 text-white">Whether you’re building a brand, leading change, or just getting started, <span class="font-bold italic yellow-text"></span><span class="font-bold italic yellow-text">we’re here to help you show up</span> with confidence and clarity across digital platforms. </p>
        </div>
    </div>
   </section>
  <!-- Section Hero -->

  <!-- section Values -->
  <section class="section-values">
    <div class="container wrapper">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
        <div>
          <Image src={ValuesImg} alt="Segula Global's values" />
        </div>
        <div>
          <h1
        class="text-3xl md:text-4xl font-extrabold mb-4 max-w-5xl mx-auto"
      >
        Our Values
      </h1>
          <p class="mb-8">Authenticity</span>
            We believe in keeping it real with genuine stories, honest work, and purpose at the core of everything we do.</p>
          <p>Excellence 
            We’re all about high standards. From strategy to execution, we show up with quality and consistency every time.</p>
        </div>
      </div>
    </div>
  </section>



    <!-- section Mission -->
    <section class="section-mission py-32 border-b border-gray-400">
      <div class="container wrapper">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
          <div>
            <Image src={ValuesImg} alt="Segula Global's values" />
          </div>
          <div>
            <h1
        class="text-3xl md:text-4xl font-extrabold mb-4 max-w-5xl mx-auto"
      >
        Our Mission
      </h1>
            <p class="mb-8">We are here to empower purpose-driven leaders and help them make a bigger impact by amplifying voices that are changing the world. We’re here to foster inclusivity, spark meaningful conversations, and inspire the next generation of leaders who are driving social change.</p>
          </div>
        </div>
      </div>
    </section>




  <!-- Section Team members -->
  <div class="section-team" id="team">
    <div class="container wrapper">
      <h1
        class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto"
      >
      The Team
      </h1>
      <p class="max-w-5xl mx-auto text-center">
        Meet the amazing people making it all happen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
          {
            teams.map((team) => (
              <div class="member">
                <div class="member-head">
                  <Image src={team.image} alt={team.name}/>
                  <h3>{team.name}</h3>
                  <p>{team.title}</p>
                </div>
                <div class="member-details">
                  <p class="px-4">{team.details}</p>
                </div>
                <ul class="social-list">
                  <li class="social-item">
                    <a href={team.linkedin} class="social-link">
                      <i class="fa-brands fa-linkedin-in" />
                    </a>
                  </li>
                  <li class="social-item">
                    <a href={team.website} class="social-link">
                      <i class="fa-solid fa-earth-africa" />
                    </a>
                  </li>
                  <li class="social-item">
                    <a href={team.instagram} class="social-link">
                      <i class="fa-brands fa-instagram" />
                    </a>
                  </li>
                </ul>
              </div>
            ))
          }
      </div>
    </div>
  </div>





  <!-- join out team -->
  <section class="section-join">
    <div class="container wrapper">
      <div class="text-center max-w-5xl mx-auto">
        <h1
        class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto"
      >
        Join Our Team
      </h1>
            <p class="mb-8">We’re always looking for creative, driven individuals to join our team and help shape the future of digital storytelling.</p>
            <a href="/careers" class="btn btn-yellow">Our Openings</a>
      </div>
    </div>
  </section>


  <!-- Section clients -->
  <section class="section-client py-28" id="clients">
    <div class="container wrapper">
      <h1
        class="text-3xl md:text-4xl font-extrabold text-center mb-12 max-w-5xl mx-auto"
      >
        Our Clients
      </h1>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
        <Image src={Irisk} alt="Irisk Management Ltd" />
        <Image src={Wliafrica} alt="Women Leadership In Insurance Africa" />
        <Image src={Ibag} alt="Insurance Brokers Association of Ghana (IBAG)" />
        <Image src={Nsia} alt="NSIA Insurance Ghana" />
        <Image src={Aceltrim} alt="Aceltrim Ghana" />
        <Image src={Coronation} alt="Coronation Insurance Ghana" />
        <Image src={NGI} alt="Nothern Girl Initiative" />
        <Image src={Swristberg} alt="Sheila Wristberg" />
        <Image src={APL} alt="Africa Policy Lens" />
      </div>
    </div>
  </section>
  <!-- End of section clients -->




  <!-- Section Footer -->
  <Footer />
</MainLayout>

<style lang="scss">

  // Section Hero
  .section-hero {
        width: 100%;
        height: 100vh;
        background-image: linear-gradient(to bottom, var(--clr-green-dark), var(--clr-green));

        .hero-content {
            max-width: 1000px;
            margin-inline: auto;
        }
    }


    // Section values
    .section-values {
      background-color: var(--clr-green);
      padding: 8rem 0 10rem;
      color: var(--clr-white);
    }



    // section join
    .section-join {
      background-color: var(--clr-green-light);
      padding: 5rem 0;
    }





    
  .section-team {
    padding: 7rem 0;
  }
  .member {
    background-color: #f8f8f8;
    padding: 2rem 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.2);
    text-align: center;
    border: 1px solid #b3b3b3;
    transition: 0.3s;

    &:hover {
      transform: translateY(-4px);
    }

    &-head {
      margin-bottom: 2rem;

      img {
        // width: 100%;
        display: inline-block;
        margin-bottom: 1rem;
        max-width: 250px;
      }

      h3 {
        font-weight: bold;
        font-size: 1.5rem;
      }
      p {
        color: var(--clr-green);
        font-size: 1rem;
      }
    }

    .social-list {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 1rem;

      .social-item {
        &:not(:last-child) {
          margin-right: 1rem;
        }
      }

      .social-link {
        display: flex;
        width: 3rem;
        height: 3rem;
        align-items: center;
        justify-content: center;
        background-color: #d8d8d8;
        border: 2px solid #cdcdcd;
        border-radius: 50%;
        color: var(--clr-white);
        transition: 0.4s ease-out;

        &:hover,
        &:focus {
          color: var(--clr-white);
          background-color: var(--clr-green);
        }
      }
    }
  }





  // Section Clients
  .section-client {


    img {
      transition: .4s;
      &:hover, &:focus {
        transform: translateY(-5px);
      }
    }
  }
</style>
