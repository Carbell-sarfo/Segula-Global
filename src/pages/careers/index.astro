---
import Navigation from "~/components/navigation.astro";
import Footer from "~/components/footer.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import CareerCard from "~/components/CareerCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allCareers: CollectionEntry<"careers">[] = (await getCollection("careers")).sort(
  (a: CollectionEntry<"careers">, b: CollectionEntry<"careers">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<MainLayout title="Join our team and shape the future of personal branding.">
  <Navigation />

<section class="section-hero">
    <div class="container wrapper">
        <div class="w-full h-full hero-content text-center flex align-center flex-col justify-center flex-wrap">
            <h1 class="text-8xl md:text-6xl font-extrabold text-white">Careers at Segula Global</h1>
            <p class="my-8 text-white">If you're looking for an <span class="font-bold italic yellow-text">opportunity to grow, create, and contribute to meaningful projects,</span> <span class="font-bold italic yellow-text"></span> we want you to join us!</p>
        </div>
    </div>
   </section>
  <!-- Section Hero -->


  <!-- section join -->
   <section class="section-joing py-20 border border-b-2 border-gray-200">
    <div class="container wrapper">
        <div class="text-center">
            <h1 class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto">Be Part of the Team That’s Redefining Branding.</h1>
        </div>
        <p class="max-w-5xl mx-auto">Thinking about joining Segula Global? We’re excited to connect with passionate and creative minds like yours! Send your CV, a cover letter, and your portfolio (if you have one) to segulaglobal@gmail.com. Then, take a moment to fill out the form below — it helps us learn more about you. We can’t wait to hear from you. Good luck!</p>
    </div>
   </section>
  <!-- end of section join -->



  <!-- section career listing -->
   <section class="section-listing py-36">
    <div class="container wrapper">
        <h1 class="text-3xl md:text-4xl font-extrabold text-center mb-4 max-w-5xl mx-auto">Opportunities</h1>
        <p class="max-w-5xl mx-auto mb-20">We’re always looking for creative, driven individuals to join our team. Check out these exciting opportunities:</p>

        <div class="career-list max-w-5xl mx-auto">
            {allCareers.map((career) => <CareerCard career={career}/>)}
        </div>
    </div>
   </section>
  <!-- end of career listing -->


  <Footer />
</MainLayout>



<style lang="scss">

    .section-hero {
        width: 100%;
        height: 100vh;
        background-image: linear-gradient(to bottom, var(--clr-green-dark), var(--clr-green));

        .hero-content {
            max-width: 1000px;
            margin-inline: auto;
        }
    }





    .section-listing {
    }
</style>